# 환자 혈장 코호트를 섞지 않고 채점하는 설정 예시 (탐색용, 1차 지표 아님)
#
#   혈장은 이미 몸 안에서 희석돼 있어서 또 섞으면 종양 리드가 검출 한계 아래로 내려감
#   → 사람마다 자기 리드만으로 채점, 같은 플랫폼의 비악성 대조도 같이 채점해 음성으로 사용
#   (조직, 세포주처럼 섞어 쓰는 코호트는 sample_cohort.conf.example)
#
#   사용법
#     cp patient_plasma.conf.example ~/cohorts/<코호트이름>.conf   (값 채우기)
#     COHORT=<코호트이름> bash 3_validate/run_validate.sh j16jsd200_5k_uni 8   (판마다)
#     COHORT=<코호트이름> python 4_report/steps/plasma_baseline.py --cov ... -o baseline.csv
#     COHORT=<코호트이름> python 4_report/steps/plasma_metric.py --baseline baseline.csv \
#         j16bl200 j16jsd200 j16jsdb200
#
#   주의: 이 코호트에는 4_report/make_report.sh 안 씀 (NEG_SAMPLES 있으면 중단)
#     판정은 plasma_metric.py 로만
#
#   주의: 깊이는 한 사람 리드만으로 채워야 해서 50k, 100k 는 대부분 못 채움
#     못 채운 사람은 섞기 단계에서 빠지고 plasma_metric.py 가 사람 수 맞춰 보고 중단

# 배경
# RATIOS 의 0.0 행(배경만)이 위장 대조로 쓰임. 학습에 안 쓴 음성이어야 함
# NORMAL 은 병합 정상 BAM, NORMALS_5K 는 5k 판용 공여자별 BAM (공백 구분), NREP_5K 는 그 반복 수
NORMAL=/path/to/your/merged_normal.bam
NORMALS_5K=/path/to/bg01.bam /path/to/bg02.bam /path/to/bg03.bam
NREP_5K=10

# 사람
# CANCER 의 {sample} 자리에 SAMPLES 각 이름이 들어감
# 환자와 비악성 대조 둘 다 SAMPLES 에 넣고, 비악성 대조는 NEG_SAMPLES 에도 적음
# 아래는 형식만 보여주는 가짜 이름 (실제 검체 ID 목록은 공개 저장소에 올리지 않음)
CANCER=/path/to/your/{sample}.bam
SAMPLES=PATIENT_001 PATIENT_002 PATIENT_003 DONOR_001 DONOR_002
NEG_SAMPLES=DONOR_001 DONOR_002

# 섞기
# RATIOS 는 0.0 과 1.0 만 (1.0 = 자기 리드 100%, 0.0 빼면 위장 대조 못 함)
# NREP 는 비율당 반복 수, LAYOUT 은 리드 방식 기록용
RATIOS=0.0, 1.0
NREP=10
LAYOUT=mixed
