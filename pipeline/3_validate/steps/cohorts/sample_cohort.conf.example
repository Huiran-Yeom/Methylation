# 코호트 정의 예시. 실제 코호트 파일은 저장소에 안 넣음
#   (검체 ID 목록은 식별자이고 통제접근 자료면 이용 협약 범위일 수 있음, 구조만 남김)
#
#   사용법
#     1) 복사해서 코호트 이름으로 저장
#          cp sample_cohort.conf.example ~/cohorts/<코호트이름>.conf
#     2) 아래 값을 자기 자료에 맞게 채우기
#     3) 그 코호트 이름으로 검증 실행
#          COHORT=<코호트이름> bash 3_validate/run_validate.sh <판이름> 8
#
#   코호트 이름은 0_setup/config.conf 의 VAL_COHORTS 에도 넣어야 함 (없으면 중단)

# 음성 배경
# 학습에 안 쓴 정상 BAM. 학습 정상과 겹치면 검증 아님 (겹침 0 확인하고 근거 남기기)
NORMAL=/path/to/your/merged_normal.bam

# 양성 검체
# {sample} 자리에 아래 SAMPLES 각 이름이 들어감
CANCER=/path/to/your/{sample}_pool.bam

# 검체 목록
# 공백 구분. 아래는 형식만 보여주는 가짜 이름 셋 (실제 목록은 공개 저장소에 올리지 않음)
# 검체 수 = 분모, 코드가 이 줄의 이름 수를 셈
SAMPLES=SAMPLE_001 SAMPLE_002 SAMPLE_003

# 섞기
# 비율당 반복 수. 깊이별로 다르게 하려면 NREP_5K 처럼 씀
NREP=8

# 암 비율 (쉼표 구분). 학습과 같아야 비교 가능
RATIOS=0.0, 0.001, 0.005, 0.01, 0.02, 0.025, 0.03, 0.05

# 리드 방식, 기록용 (PE, SE 둘 다 그대로 돎)
# 비워 두면 BAM 열어 자동 감지해서 기록
LAYOUT=mixed

# 공여자별 배경 (선택)
# 비우면 위 NORMAL 병합본 하나에서 전부 뽑음
# 채우면 반복마다 배경 전원에게서 같은 몫(정상 리드 / 사람 수)을 뽑음, 못 채운 몫은 남는 사람에게 나눔 (한 반복 = 한 사람 아님)
# 공백 구분 BAM 목록. 얕은 공여자는 깊은 판 못 채워서 깊이별로 따로 (NORMALS_5K, NREP_5K 등)
NORMALS=
NORMALS_5K=/path/to/bg01.bam /path/to/bg02.bam /path/to/bg03.bam
NREP_5K=10
NORMALS_50K=
NREP_50K=10
NORMALS_100K=
NREP_100K=10
