# 코호트 정의 — 예시(샘플)입니다. 실제 코호트 파일은 저장소에 넣지 않습니다.
#
#   왜 넣지 않나
#     실제 파일에는 검체 식별자 목록과 참여자 이름이 들어갑니다. 환자 유래 검체
#     ID 는 그 자체로 식별자이고, 통제접근 데이터셋(EGA 등)의 검체 목록은 데이터
#     이용 협약 범위일 수 있습니다. 그래서 구조만 남기고 값은 지웠습니다.
#
#   쓰는 법
#     1) 이 파일을 복사해 이름을 코호트 이름으로 바꿉니다:
#          cp sample_cohort.conf.example ~/cohorts/<코호트이름>.conf
#     2) 아래 값을 자기 자료에 맞게 채웁니다.
#     3) 검증을 그 코호트 이름으로 돌립니다:
#          COHORT=<코호트이름> bash 3_validate/run_validate.sh <판이름> 8
#
#   ※ 코호트 이름은 0_setup/config.conf 의 VAL_COHORTS 에도 넣어야 합니다.
#     그 관문은 «옛 세대 코호트로 새 판을 채점하는 것» 을 막기 위한 것입니다.

# ── 음성 배경 ────────────────────────────────────────────────────────
# 학습에 쓰지 않은 정상 BAM. 학습 정상과 겹치면 검증이 아닙니다 — 겹침 0 을
# 확인하고 그 근거를 남기십시오.
NORMAL=/path/to/your/merged_normal.bam

# ── 양성 검체 ────────────────────────────────────────────────────────
# {sample} 자리에 아래 SAMPLES 의 각 이름이 들어갑니다.
CANCER=/path/to/your/{sample}_pool.bam

# ── 검체 목록 ────────────────────────────────────────────────────────
# 공백으로 띄웁니다. 아래는 «형식만» 보여 주는 가짜 이름 셋입니다.
#   ★ 실제 목록을 여기 적어 공개 저장소에 올리지 마십시오.
#   ★ 검체 수가 곧 분모입니다 — 코드가 이 줄의 낱말 수를 셉니다(박아 두지 않습니다).
SAMPLES=SAMPLE_001 SAMPLE_002 SAMPLE_003

# ── 섞기 ─────────────────────────────────────────────────────────────
# 비율당 복제본 수. 깊이별로 다르게 하려면 NREP_5K 처럼 씁니다.
NREP=8

# 암 조각 비율. 학습과 같아야 비교가 됩니다.
RATIOS=0.0, 0.001, 0.005, 0.01, 0.02, 0.025, 0.03, 0.05

# 리드 방식. mixed 면 PE·SE 를 그대로 다룹니다.
#   ※ single 로 바꾸면 to_single() 이 SE 전용으로 변환합니다 — PE·SE 혼합 자료에는
#     쓰지 마십시오.
LAYOUT=mixed

# ── 공여자별 배경 (선택) ─────────────────────────────────────────────
# 비우면 위 NORMAL 병합본 하나에서 전부 뽑습니다.
# 채우면 반복 i 가 배경 i 를 씁니다 — 「사람마다 얼마나 다른가」를 볼 수 있습니다.
#   ★ 얕은 공여자는 깊은 판을 혼자 못 채웁니다. 깊이별로 가르십시오.
#     섞으면 «사람» 과 «병합본» 이 한 표에 섞여 해석이 무너집니다.
NORMALS=
NORMALS_5K=/path/to/bg01.bam /path/to/bg02.bam /path/to/bg03.bam
NREP_5K=10
NORMALS_50K=
NREP_50K=10
NORMALS_100K=
NREP_100K=10
